# Edit these, then run the cloud/*.sh scripts from your laptop (needs gcloud).
PROJECT="sodium-hue-408214"
ZONE="europe-west4-a"                 # v6e zones: us-east5-a/b, us-central1-a, europe-west4-a
VM="psb-tpu"
MACHINE="ct6e-standard-1t"        # 4 chips. Use ct6e-standard-1t (1 chip) for debugging.
PROVISIONING="SPOT"         # or SPOT: cheaper but can be preempted (runs resume)
MAX_RUN="8h"                     # the VM deletes itself after this, whatever happens
DISK="psb-data"                   # persistent disk: code, venv, results, compile cache
DISK_SIZE="100GB"
GCS_BUCKET=""                     # optional: mirror results to gs://$GCS_BUCKET/psb_results
COST_CAP_USD="150"                # run_all.sh stops once estimated spend passes this
SELF_DELETE="1"                   # delete the VM when the sweep finishes (disk is kept)
